# Copy these values into your shell or hosting provider settings.
# This file is documentation only; the app does not auto-load .env files.
SECRET_KEY=replace-with-a-long-random-secret
APP_PASSWORD=replace-with-a-strong-unique-password

# Optional Telegram integration
BOT_TOKEN=
CHAT_ID=

# Optional: defaults to tasks.db
DATABASE_PATH=tasks.db

# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0

# Optional prayer-time location (generic Cairo defaults are used if omitted)
CITY=Cairo, Egypt
PRAYER_LAT=30.0444
PRAYER_LNG=31.2357
PRAYER_METHOD=5

# Optional bind address and port; localhost is safest for personal use
HOST=127.0.0.1
PORT=5000
